# =====================================================================
# BU Agent .env — copy 成 .env 後填入 LLM key 即可
#
# EC2 部署：scp -r BU_Agent ec2-user@<ip>:~/  →  cp .env.example .env
# →  填下面 LLM key  →  docker compose up --build -d
# Security Group 對外開 3000（前端）+ 8000（SSE 直連）。
# 瀏覽器開 http://<ec2-public-ip>:3000 即可。
# =====================================================================

# ---------- 必填：LLM API Key（任一即可，建議兩個都填讓使用者切換） ----------
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------- LLM 路由 / 模型 ----------
# auto: 依 model id 前綴自動選後端（gpt-* → openai；gemini-* → gemini）
# openai / gemini: 強制走該後端
# mock: 離線罐頭回應（沒 key 時可用，UI 仍能跑）
LLM_MODE=auto
GEMINI_MODEL=gemini-2.5-pro
OPENAI_MODEL=gpt-4o-mini
# 前端模型選單白名單（CSV）+ 預設選項
ALLOWED_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini,gemini-2.5-pro
DEFAULT_MODEL=gpt-4o-mini

# ---------- App ----------
APP_ENV=prod          # prod / local（local 才掛 uvicorn --reload）
LOG_LEVEL=INFO

# CORS：PoC IP 部署用 *；上 SSO / domain 時收緊到實際 origin（CSV）
CORS_ORIGINS=*

# ---------- Auth（M0–M2 PoC 用 mock；上 Cathay SSO 時改 sso 並補 OIDC_*） ----------
AUTH_MODE=mock
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# ---------- 進階：通常不需動 ----------
# DB / Checkpoint URL：docker-compose 會自動注入 service-name 版本（postgres:5432），
# 此處留空即可。只有「不走 docker-compose、用 host-side uvicorn」時才需要設成
# postgresql+psycopg://bu_agent:bu_agent@localhost:5432/bu_agent
DATABASE_URL=
LANGGRAPH_CHECKPOINT_URL=

# Frontend：通常不需動。
# - NEXT_PUBLIC_API_BASE 留空 → 走 same-origin Next.js proxy（推薦）
# - NEXT_PUBLIC_API_BASE_BROWSER 留空 → SSE runtime 從 window.location 推 backend
#   只有上 HTTPS / domain / 反向代理時才需指定，例：
#   NEXT_PUBLIC_API_BASE_BROWSER=https://bu-agent.example.com
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_API_BASE_BROWSER=
NEXT_PUBLIC_AUTH_MODE=mock
