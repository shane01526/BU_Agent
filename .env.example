# ========== Backend ==========
# DB（docker-compose 內連 postgres；host 上連 localhost）
DATABASE_URL=postgresql+psycopg://bu_agent:bu_agent@localhost:5432/bu_agent
# LangGraph 的 PostgresSaver 用同一個 DB 的獨立 schema
LANGGRAPH_CHECKPOINT_URL=postgresql://bu_agent:bu_agent@localhost:5432/bu_agent

# LLM
# LLM_MODE: auto / gemini / openai / mock
LLM_MODE=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 前端模型選單白名單（CSV）+ 預設
ALLOWED_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini,gemini-2.5-pro
DEFAULT_MODEL=gpt-4o-mini

# Auth
# M0-M2 PoC：mock。改 "sso" 時需補 OIDC 變數
AUTH_MODE=mock
# OIDC（上線串 SSO 時再填）
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# App
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ========== Frontend ==========
# Next.js public env（會 bundle 進 client）
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=mock
