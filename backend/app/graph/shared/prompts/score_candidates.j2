{
  "direction": "理賠文件型別自動分類",
  "process_target": "理賠文件",
  "project_type": "分類",
  "score_5d": {"rule_repeat": 4, "data_avail": 4, "reversibility": 5, "scale_roi": 4, "gap": 5},
  "score_5d_desc": {
